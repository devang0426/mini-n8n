{
  "table": {
    "name": "audit_logs",
    "schema": "public"
  },
  "object_relationships": [
    {
      "name": "actor",
      "using": {
        "foreign_key_constraint_on": "actor_id"
      }
    },
    {
      "name": "organization",
      "using": {
        "foreign_key_constraint_on": "org_id"
      }
    }
  ],
  "select_permissions": [
    {
      "role": "user",
      "permission": {
        "columns": [
          "id",
          "org_id",
          "actor_id",
          "action",
          "resource_type",
          "resource_id",
          "metadata",
          "created_at"
        ],
        "filter": {
          "organization": {
            "members": {
              "role": {
                "_in": [
                  "owner",
                  "editor",
                  "viewer"
                ]
              },
              "user_id": {
                "_eq": "X-Hasura-User-Id"
              }
            }
          }
        }
      }
    }
  ]
}