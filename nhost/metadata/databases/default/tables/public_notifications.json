{
  "table": {
    "name": "notifications",
    "schema": "public"
  },
  "object_relationships": [
    {
      "name": "organization",
      "using": {
        "foreign_key_constraint_on": "org_id"
      }
    },
    {
      "name": "step_run",
      "using": {
        "foreign_key_constraint_on": "step_run_id"
      }
    },
    {
      "name": "workflow_run",
      "using": {
        "foreign_key_constraint_on": "workflow_run_id"
      }
    }
  ],
  "select_permissions": [
    {
      "role": "user",
      "permission": {
        "columns": [
          "id",
          "org_id",
          "workflow_run_id",
          "step_run_id",
          "channel",
          "recipient",
          "payload",
          "delivery_status",
          "delivered_at",
          "attempt_count",
          "created_at",
          "updated_at"
        ],
        "filter": {
          "organization": {
            "members": {
              "role": {
                "_in": [
                  "owner",
                  "editor",
                  "viewer"
                ]
              },
              "user_id": {
                "_eq": "X-Hasura-User-Id"
              }
            }
          }
        }
      }
    }
  ],
  "event_triggers": [
    {
      "name": "on_notification_created",
      "definition": {
        "enable_manual": false,
        "insert": {
          "columns": "*"
        }
      },
      "retry_conf": {
        "interval_sec": 10,
        "num_retries": 0,
        "timeout_sec": 60
      },
      "webhook": "http://localhost:3000/api/events/notifications",
      "headers": [
        {
          "name": "x-webhook-secret",
          "value": "933711c11c9b22f1537204d5bd536a5a957cb37cb24d320c6f755a5a07ed485c"
        }
      ]
    }
  ]
}