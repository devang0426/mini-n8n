{
  "table": {
    "name": "organizations",
    "schema": "public"
  },
  "array_relationships": [
    {
      "name": "audit_logs",
      "using": {
        "foreign_key_constraint_on": {
          "column": "org_id",
          "table": {
            "name": "audit_logs",
            "schema": "public"
          }
        }
      }
    },
    {
      "name": "members",
      "using": {
        "foreign_key_constraint_on": {
          "column": "org_id",
          "table": {
            "name": "org_members",
            "schema": "public"
          }
        }
      }
    },
    {
      "name": "notifications",
      "using": {
        "foreign_key_constraint_on": {
          "column": "org_id",
          "table": {
            "name": "notifications",
            "schema": "public"
          }
        }
      }
    },
    {
      "name": "runs",
      "using": {
        "foreign_key_constraint_on": {
          "column": "org_id",
          "table": {
            "name": "workflow_runs",
            "schema": "public"
          }
        }
      }
    },
    {
      "name": "workflows",
      "using": {
        "foreign_key_constraint_on": {
          "column": "org_id",
          "table": {
            "name": "workflows",
            "schema": "public"
          }
        }
      }
    }
  ],
  "select_permissions": [
    {
      "role": "user",
      "permission": {
        "columns": [
          "id",
          "name",
          "quota_limit",
          "quota_used",
          "quota_reset_at",
          "created_at",
          "updated_at"
        ],
        "filter": {
          "members": {
            "role": {
              "_in": [
                "owner",
                "editor",
                "viewer"
              ]
            },
            "user_id": {
              "_eq": "X-Hasura-User-Id"
            }
          }
        }
      }
    }
  ],
  "update_permissions": [
    {
      "role": "user",
      "permission": {
        "columns": [
          "name"
        ],
        "filter": {
          "members": {
            "role": {
              "_eq": "owner"
            },
            "user_id": {
              "_eq": "X-Hasura-User-Id"
            }
          }
        },
        "check": null
      }
    }
  ]
}